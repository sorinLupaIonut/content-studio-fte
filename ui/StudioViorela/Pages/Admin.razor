@page "/admin"
@inject StudioApiClient Api

@* The only page that sees money. Everything a tester is shown is a percentage;
   here the real figures are fine, because the server refuses this data to anyone
   whose row is not role='admin' - the hidden nav entry is a convenience, not the
   guard. *@

<PageTitle>@T[Copy.AdminTitle]</PageTitle>

<section class="page-heading">
    <div>
        <span class="eyebrow">@T[Copy.AdminNav]</span>
        <h1>@T[Copy.AdminTitle]</h1>
        <p>@T[Copy.AdminIntro]</p>
    </div>
</section>

@if (_notice is not null)
{
    @* The Phrase, resolved at render. Storing the resolved string would freeze
       the message in whichever language was current when it was raised, and it
       would still be sitting there in the old one after a switch. *@
    <div class="notice notice-ok" role="status">@T[_notice]</div>
}
@if (_error is not null)
{
    <div class="notice notice-error" role="alert">@_error</div>
}

@* An empty list because we were refused is not an empty list. Until 2026-08-31
   a non-admin who typed /admin was told both "this page is for the
   administrator only" AND "no accounts provisioned yet" — the second one is a
   statement about data the page was never allowed to read. *@
@if (_accounts.Count == 0 && _error is null)
{
    <section class="empty-state">
        <span class="empty-illustration">⚙</span>
        <p>@T[Copy.AdminEmpty]</p>
    </section>
}
else if (_accounts.Count > 0)
{
    <section class="table-scroll">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>@T[Copy.AdminColAccount]</th>
                    <th>@T[Copy.AdminColRole]</th>
                    <th>@T[Copy.AdminColUsed]</th>
                    <th>@T[Copy.AdminColBudget]</th>
                    <th>@T[Copy.AdminColCalls]</th>
                    <th>@T[Copy.AdminColLastUsed]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var account in _accounts)
                {
                    <tr class="@(account.Disabled ? "is-suspended" : "")">
                        <td>
                            <strong>@account.ClientName</strong>
                            @if (string.IsNullOrEmpty(account.Email))
                            {
                                <small class="muted-copy">@T[Copy.AdminNoSignIn]</small>
                            }
                            else
                            {
                                <small>@account.Email</small>
                            }
                            @if (account.Disabled)
                            {
                                <small class="tag-suspended">@T[Copy.AdminSuspended]</small>
                            }
                        </td>
                        <td>@account.Role</td>
                        <td class="num">
                            <div class="usage-track usage-track-inline">
                                <div class="usage-fill @(account.PercentUsed >= 100 ? "is-full" : "")"
                                     style="width: @(account.PercentUsed)%"></div>
                            </div>
                            <span>@account.PercentUsed% · @account.SpentDisplay</span>
                        </td>
                        <td class="num">
                            @if (_editing == account.ClientSlug)
                            {
                                <input class="budget-input"
                                       type="number"
                                       min="0"
                                       step="0.5"
                                       @bind="_editDollars" />
                            }
                            else
                            {
                                @account.BudgetDisplay
                            }
                        </td>
                        <td class="num">@account.Events</td>
                        <td>@Moment(account.LastUsedAt)</td>
                        <td class="row-actions">
                            @if (_editing == account.ClientSlug)
                            {
                                <button class="button button-small" @onclick="() => _editing = null">
                                    @T[Copy.AdminCancel]
                                </button>
                                <button class="button button-small button-primary"
                                        disabled="@_busy"
                                        @onclick="() => SaveBudgetAsync(account.ClientSlug)">
                                    @T[Copy.AdminSave]
                                </button>
                            }
                            else
                            {
                                <button class="button button-small"
                                        @onclick="() => StartEdit(account)">
                                    @T[Copy.AdminSetBudget]
                                </button>
                                @* Suspending is reversible and keeps the usage
                                   rows; it is a timestamp, not a delete. It acts
                                   on a principal, so a client nobody has signed
                                   in as has nothing to suspend - and an admin is
                                   never offered, because `db/provision.py` is the
                                   only thing that makes one and the only thing
                                   that should unmake one. The server enforces it;
                                   this only keeps the interface honest. *@
                                @if (!string.IsNullOrEmpty(account.PrincipalId)
                                     && !account.IsAdmin)
                                {
                                    <button class="button button-small"
                                            disabled="@_busy"
                                            @onclick="() => ToggleDisabledAsync(account)">
                                        @(account.Disabled
                                            ? T[Copy.AdminRestore]
                                            : T[Copy.AdminSuspend])
                                    </button>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
}

@code {
    [CascadingParameter(Name = "T")] public Translator T { get; set; } = new("ro");

    private List<AdminAccountDto> _accounts = new();
    private string? _editing;
    private Phrase? _notice;
    private string? _error;
    private bool _busy;

    // Dollars in the field, micro-dollars on the wire. The conversion happens
    // once, here, at the edge - see pricing.py for why nothing downstream is
    // allowed to hold money as a float.
    private decimal _editDollars = 1m;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _accounts = (await Api.GetAdminAccountsAsync()).Items;
            _error = null;
        }
        catch (StudioApiException ex) when (ex.StatusCode == 403)
        {
            _error = T[Copy.AdminForbidden];
        }
        catch (StudioApiException ex)
        {
            _error = ex.Message;
        }
    }

    private void StartEdit(AdminAccountDto account)
    {
        _editing = account.ClientSlug;
        _editDollars = account.BudgetMicros / 1_000_000m;
    }

    private async Task SaveBudgetAsync(string clientSlug)
    {
        _busy = true;
        try
        {
            await Api.SetBudgetAsync(clientSlug, ToMicros(_editDollars));
            _editing = null;
            _notice = Copy.AdminBudgetSaved;
            _error = null;
            await LoadAsync();
        }
        catch (StudioApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ToggleDisabledAsync(AdminAccountDto account)
    {
        _busy = true;
        try
        {
            await Api.SetDisabledAsync(account.PrincipalId!, !account.Disabled);
            _notice = Copy.AdminSuspendSaved;
            _error = null;
            await LoadAsync();
        }
        catch (StudioApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private string Moment(string? iso) =>
        string.IsNullOrEmpty(iso)
            ? T[Copy.AdminNever]
            : DateTimeOffset.TryParse(iso, out var moment)
                ? moment.LocalDateTime.ToString("dd.MM.yyyy HH:mm")
                : iso;

    private static long ToMicros(decimal dollars) =>
        (long)decimal.Round(dollars * 1_000_000m, 0, MidpointRounding.AwayFromZero);
}
