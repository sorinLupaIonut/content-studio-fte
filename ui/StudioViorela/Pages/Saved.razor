@page "/saved"
@implements IDisposable
@using System.Text.Json
@inject StudioApiClient Api
@inject StudioContextState ContextState

<PageTitle>@T[Copy.SavedTab]</PageTitle>

<section class="page-heading">
    <div>
        <span class="eyebrow">@T[Copy.SavedEyebrow]</span>
        <h1>@T[Copy.SavedHeading]</h1>
        <p>@T[Copy.SavedLede]</p>
    </div>
    <span class="step-chip">@Values.SavedPosts(T, _posts.Count)</span>
</section>

@if (_error is not null)
{
    <div class="notice notice-error" role="alert">
        <span>@_error</span>
        <button class="icon-button" type="button" @onclick="() => _error = null" aria-label="@T[Copy.DismissMessage]">×</button>
    </div>
}

@if (_message is not null)
{
    <div class="notice notice-success" role="status">@_message</div>
}

@if (_loading)
{
    <section class="loading-card" aria-live="polite">
        <span class="spinner"></span> @T[Copy.SavedLoading]
    </section>
}
else if (_posts.Count == 0)
{
    <section class="empty-state">
        <span class="empty-illustration">♡</span>
        <h2>@T[Copy.SavedEmptyHeading]</h2>
        <p>@T[Copy.SavedEmptyBody]</p>
        <a class="button button-primary" href="/generator">@T[Copy.SavedEmptyCta]</a>
    </section>
}
else
{
    <section class="saved-list" aria-label="@T[Copy.SavedListAria]">
        @foreach (var post in _posts)
        {
            <article class="saved-card @(IsOpen(post.Id) ? "open" : null)">
                <button class="saved-card-header" type="button" @onclick="() => ToggleAsync(post)" aria-expanded="@IsOpen(post.Id)">
                    <span class="saved-date">@post.PostedOn</span>
                    <span class="saved-title">
                        <strong>@post.Title</strong>
                        <small>@Values.FormatLabel(T, post.Format) · @Values.PillarLabel(T, post.Pillar) · @HookLabel(post.HookType)</small>
                    </span>
                    <span class="chevron @(IsOpen(post.Id) ? "open" : null)">⌄</span>
                </button>

                @if (IsOpen(post.Id) && _draft is not null && _draftId == post.Id)
                {
                    <div class="saved-editor">
                        @if (_dirty)
                        {
                            <div class="draft-banner" role="status">
                                @T[Copy.UnsavedDraft]
                            </div>
                        }

                        <label class="editor-field">
                            <span>@T[Copy.FieldTitle]</span>
                            <input type="text" @bind="_draft.Title" @bind:event="oninput" @onchange="MarkDirty" />
                        </label>

                        <div class="editor-grid">
                            <label class="editor-field">
                                <span>@T[Copy.FieldPillar]</span>
                                <select @bind="_draft.Pillar" @bind:after="MarkDirty">
                                    @foreach (var value in Values.Pillars)
                                    {
                                        <option value="@value">@Values.PillarLabel(T, value)</option>
                                    }
                                </select>
                            </label>
                            <label class="editor-field">
                                <span>@T[Copy.FieldFormat]</span>
                                <select @bind="_draft.Format" @bind:after="MarkDirty">
                                    @foreach (var value in Values.Formats)
                                    {
                                        <option value="@value">@Values.FormatLabel(T, value)</option>
                                    }
                                </select>
                            </label>
                            <label class="editor-field">
                                <span>@T[Copy.FieldHookType]</span>
                                <select @bind="_draft.HookType" @bind:after="MarkDirty">
                                    @foreach (var value in HookTypes)
                                    {
                                        <option value="@value">@HookLabel(value)</option>
                                    }
                                </select>
                            </label>
                        </div>

                        <label class="editor-field">
                            <span>@T[Copy.LabelHook]</span>
                            <textarea rows="2" @bind="_draft.Hook" @bind:after="MarkDirty"></textarea>
                        </label>
                        @* Shown on what the post carries, not on its format: a silent
                           reel never had a script, while a post saved before reels went
                           mute still has one and must stay editable. *@
                        @if (HasScript)
                        {
                            <label class="editor-field">
                                <span>@T[Copy.LabelScript]</span>
                                <textarea rows="10" @bind="_draft.Script" @bind:after="MarkDirty"></textarea>
                            </label>
                        }
                        <label class="editor-field">
                            <span>@T[Copy.LabelCaption]</span>
                            <textarea rows="5" @bind="_draft.Caption" @bind:after="MarkDirty"></textarea>
                        </label>

                        <div class="editor-grid">
                            <label class="editor-field">
                                <span>@T[Copy.LabelHashtags] <small>@T[Copy.HashtagsHint]</small></span>
                                <input type="text" @bind="_hashtags" @bind:after="MarkDirty" />
                            </label>
                            <label class="editor-field">
                                <span>@T[Copy.LabelCta]</span>
                                <input type="text" @bind="_draft.Cta" @bind:after="MarkDirty" />
                            </label>
                        </div>

                        <label class="editor-field">
                            <span>@T[Copy.LabelSource]</span>
                            <input type="text" @bind="_draft.Source" @bind:after="MarkDirty" />
                        </label>

                        @if (HasScript)
                        {
                            <fieldset class="editor-production">
                                <legend>@T[Copy.LabelProduction]</legend>
                                @if (NeedsProduction)
                                {
                                    <p class="field-note">@T[Copy.LegacyProductionNote]</p>
                                }
                                <div class="editor-grid">
                                    <label class="editor-field">
                                        <span>@T[Copy.FieldDuration]</span>
                                        <input type="text" @bind="_production.DurationOrCount" @bind:after="MarkDirty" />
                                    </label>
                                    <label class="editor-field">
                                        <span>@T[Copy.FieldVisual]</span>
                                        <input type="text" @bind="_production.VisualDirection" @bind:after="MarkDirty" />
                                    </label>
                                </div>
                                <label class="editor-field">
                                    <span>@T[Copy.FieldBlocks] <small>@T[Copy.BlocksHint]</small></span>
                                    <textarea rows="4" @bind="_blocks" @bind:after="MarkDirty"></textarea>
                                </label>
                            </fieldset>
                        }

                        <div class="editor-actions">
                            <button class="button button-ghost" disabled="@(_busy || !_dirty)" @onclick="() => ResetAsync(post)">@T[Copy.DiscardChanges]</button>
                            <button class="button button-primary" disabled="@(_busy || !_dirty)" @onclick="() => PrepareUpdateAsync(post)">
                                @(_busy && _updateRun is null ? T[Copy.Preparing] : T[Copy.SaveChanges])
                            </button>
                        </div>

                        @if (_updateRun is not null)
                        {
                            <ApprovalPanel Run="_updateRun"
                                           Busy="_busy"
                                           Title="@T[Copy.ReplacePostTitle]"
                                           Message="@T[Copy.ReplacePostMessage]"
                                           RejectLabel="@T[Copy.NotNow]"
                                           Summary="UpdateSummary"
                                           OnDecision="DecideUpdateAsync" />
                        }
                    </div>
                }
            </article>
        }
    </section>
}

@code {
    [CascadingParameter(Name = "T")] public Translator T { get; set; } = new("ro");

    /// <summary>Stored hook values, in the order the editor offers them.</summary>
    private static readonly string[] HookTypes =
        ["PROVOCARE", "CIFRA", "SECRET", "INTREBARE", "CONTRAST"];

    private List<SavedPostDto> _posts = [];
    private PostContentDto? _draft;
    private string? _draftId;
    private string _hashtags = "";
    private string _blocks = "";

    // The production block is edited through this working copy so the three
    // inputs can bind to something non-null even while the draft's own
    // `FormatDetails` is absent. `PrepareUpdateAsync` decides which one travels.
    private FormatDetailsDto _production = new();
    private RunResponseDto? _updateRun;
    private string? _error;
    private string? _message;
    private bool _loading = true;
    private bool _busy;
    private bool _dirty;

    /// <summary>
    /// A silent reel has no script, and no production block either. Everything
    /// she would have said is in the caption, so those two fieldsets are not
    /// hidden fields — they are fields the post does not have.
    /// </summary>
    private bool HasScript => !string.IsNullOrWhiteSpace(_draft?.Script);

    /// <summary>Posts saved before the production block exists have it empty.</summary>
    private bool NeedsProduction =>
        _draft is not null
        && (_blocks.Trim().Length == 0
            || _production.VisualDirection.Trim().Length == 0
            || _production.DurationOrCount.Trim().Length == 0);

    private List<string> UpdateSummary => _draft is null
        ? []
        : [$"Titlu: {_draft.Title}", $"Hook: {HookLabel(_draft.HookType)}", $"{_draft.Format} · {_draft.Pillar}"];

    protected override async Task OnInitializedAsync()
    {
        ContextState.SavedPostPatched += OnPatchedAsync;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _posts = (await Api.GetSavedPostsAsync()).Items;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private bool IsOpen(string id) => _draftId == id;

    private async Task ToggleAsync(SavedPostDto post)
    {
        if (_draftId == post.Id)
        {
            Close();
            return;
        }

        _updateRun = null;
        _message = null;
        try
        {
            var fresh = (await Api.GetSavedPostAsync(post.Id)).Post ?? post;
            Open(fresh);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void Open(SavedPostDto post)
    {
        _draftId = post.Id;
        _draft = ToContent(post);
        _hashtags = string.Join(" ", post.Hashtags);
        _production = new FormatDetailsDto
        {
            ContentBlocks = [.. post.FormatDetails?.ContentBlocks ?? []],
            VisualDirection = post.FormatDetails?.VisualDirection ?? "",
            DurationOrCount = post.FormatDetails?.DurationOrCount ?? ""
        };
        _blocks = string.Join("\n", _production.ContentBlocks);
        _dirty = false;
        ContextState.SetSavedPost(post);
    }

    private void Close()
    {
        var closing = _draftId;
        _draftId = null;
        _draft = null;
        _updateRun = null;
        _dirty = false;
        if (closing is not null)
        {
            ContextState.ClearSavedPost(closing);
        }
    }

    private void MarkDirty()
    {
        _dirty = true;
        _updateRun = null;
    }

    private async Task ResetAsync(SavedPostDto post)
    {
        try
        {
            var fresh = (await Api.GetSavedPostAsync(post.Id)).Post ?? post;
            Open(fresh);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task PrepareUpdateAsync(SavedPostDto post)
    {
        if (_draft is null)
        {
            return;
        }

        _busy = true;
        _error = null;
        _message = null;
        _updateRun = null;
        _draft.Hashtags = _hashtags
            .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .ToList();
        _production.ContentBlocks = _blocks
            .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .ToList();
        // Absent, not empty. Sending a blank production block on a silent reel
        // would fail the contract, and an empty one would be a lie in the row.
        _draft.FormatDetails = HasScript ? _production : null;
        try
        {
            _updateRun = await Api.PreparePostUpdateAsync(post.Id, _draft);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DecideUpdateAsync(bool approved)
    {
        if (_updateRun is null)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            var result = await Api.DecideAsync(_updateRun, approved);
            _updateRun = null;
            if (approved && result.Status == "completed")
            {
                _message = T[Copy.PostReplaced];
                await LoadAsync();
                var post = _posts.FirstOrDefault(item => item.Id == _draftId);
                if (post is not null)
                {
                    Open((await Api.GetSavedPostAsync(post.Id)).Post ?? post);
                }
            }
            else
            {
                _message = T[Copy.ChangeCancelled];
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>A rewrite from chat lands in the draft only, never in the library.</summary>
    private Task OnPatchedAsync(string postId, JsonElement content)
    {
        if (_draft is null || _draftId != postId)
        {
            return Task.CompletedTask;
        }
        return InvokeAsync(() =>
        {
            var patched = content.Deserialize<PostContentDto>(
                new JsonSerializerOptions(JsonSerializerDefaults.Web));
            if (patched is not null)
            {
                _draft = patched;
                _hashtags = string.Join(" ", patched.Hashtags);
                _production = patched.FormatDetails ?? new FormatDetailsDto();
                _blocks = string.Join("\n", _production.ContentBlocks);
                _dirty = true;
                _updateRun = null;
            }
            StateHasChanged();
        });
    }

    private static PostContentDto ToContent(SavedPostDto post) => new()
    {
        Title = post.Title,
        Pillar = post.Pillar,
        Format = post.Format,
        Hook = post.Hook,
        HookType = post.HookType,
        Script = post.Script,
        Caption = post.Caption,
        Hashtags = [.. post.Hashtags],
        Cta = post.Cta,
        Source = post.Source,
        FormatDetails = post.FormatDetails
    };

    private string HookLabel(string value) => Values.HookLabel(T, value);

    public void Dispose()
    {
        ContextState.SavedPostPatched -= OnPatchedAsync;
        if (_draftId is not null)
        {
            ContextState.ClearSavedPost(_draftId);
        }
    }
}
