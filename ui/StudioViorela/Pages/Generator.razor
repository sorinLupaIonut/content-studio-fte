@page "/"
@page "/generator"
@implements IAsyncDisposable
@inject StudioApiClient Api
@inject GenerationEventStream Events
@inject StudioContextState ContextState

<PageTitle>@T[Copy.GeneratorTab]</PageTitle>

<section class="page-heading generator-heading">
    <div>
        <span class="eyebrow">@T[Copy.GeneratorEyebrow]</span>
        <h1>@T[Copy.GeneratorHeading]</h1>
        <p>@T[Copy.GeneratorLede]</p>
    </div>
    <span class="step-chip">@T[Copy.GeneratorStepChip]</span>
</section>

@if (_error is not null)
{
    <div class="notice notice-error" role="alert">
        <span>@_error</span>
        <button class="icon-button" type="button" @onclick="() => _error = null" aria-label="@T[Copy.DismissMessage]">×</button>
    </div>
}

<section class="generator-card">
    @* The option *values* are the API contract and stay Romanian in both
       languages; only what the eye reads is translated. *@
    <div class="field-grid">
        <label>
            <span>@T[Copy.FieldSource]</span>
            <select @bind="_source" disabled="@_busy">
                @foreach (var value in Values.Sources)
                {
                    <option value="@value">@Values.SourceLabel(T, value)</option>
                }
            </select>
        </label>
        <label>
            <span>@T[Copy.FieldPillar]</span>
            <select @bind="_pillar" disabled="@_busy">
                @foreach (var value in Values.Pillars)
                {
                    <option value="@value">@Values.PillarLabel(T, value)</option>
                }
            </select>
        </label>
        <label>
            <span>@T[Copy.FieldFormat]</span>
            <select @bind="_format" disabled="@_busy">
                @foreach (var value in Values.Formats)
                {
                    <option value="@value">@Values.FormatLabel(T, value)</option>
                }
            </select>
        </label>
        @* Only her account has more than one, so only her account sees this.
           The server sends the list and checks it again on start: a select that
           is not drawn is not a permission. *@
        @if (_models.Count > 1)
        {
            <label>
                <span>@T[Copy.FieldModel]</span>
                <select @bind="_model" disabled="@_busy">
                    @foreach (var value in _models)
                    {
                        <option value="@value">@Values.ModelLabel(T, value)</option>
                    }
                </select>
            </label>
        }
    </div>
    @if (_models.Count > 1)
    {
        <p class="field-note">@T[Copy.ModelNote]</p>
    }

    @* No book picker any more (2026-08-27): the agent chooses its own titles
       off the shelf, following the skill. What remains of the old fieldset is
       its one guard - a run from an empty shelf would cost money and could
       not succeed, because `search_books` is scoped to the account. *@
    @if (UsesBooks && !_libraryLoading && _library.Count == 0)
    {
        <p class="notice notice-warn" role="status">
            @T[_source == "Cărți" ? Copy.LibraryEmptyForBooks : Copy.LibraryEmptyForMixed]
        </p>
    }

    <label class="focus-field">
        <span>@T[Copy.FocusLabel] <small>@T[Copy.Optional]</small></span>
        <textarea @bind="_focus" disabled="@_busy" placeholder="@T[Copy.FocusPlaceholder]"></textarea>
    </label>
    <p class="field-note">@T[Copy.AgentBringsItsOwnMaterial]</p>
    @* "Combinat" still has memory and the internet to work with, so only the
       books-only source is blocked. *@
    <button class="button button-primary generate-button"
            disabled="@(_busy || BooksOnlyWithEmptyShelf)"
            @onclick="() => StartAsync(false)">
        @(_busy ? T[Copy.PreparingBatch] : T[Copy.GenerateTen])
    </button>
</section>

@if (_confirmReplace)
{
    <section class="replace-panel" role="alertdialog" aria-label="@T[Copy.ReplaceAria]">
        <div>
            <span class="eyebrow">@T[Copy.ReplaceEyebrow]</span>
            <h3>@T[Copy.ReplaceHeading]</h3>
            <p>@T[Copy.ReplaceBody]</p>
        </div>
        <div>
            <button class="button button-ghost" @onclick="() => _confirmReplace = false">@T[Copy.ReplaceKeep]</button>
            <button class="button button-primary" @onclick="() => StartAsync(true)">@T[Copy.ReplaceConfirm]</button>
        </div>
    </section>
}

@if (_loadingBatch)
{
    <section class="loading-card"><span class="spinner"></span> @T[Copy.LoadingBatch]</section>
}
else if (_batch is not null)
{
    <section class="ideas-list" aria-label="@T[Copy.IdeasAria]">
        <header>
            <div>
                <span class="eyebrow">@T[Copy.CurrentBatch]</span>
                <h2>@T[Copy.YourIdeas]</h2>
                <p>@BatchStatus(_batch)</p>
            </div>
            <div class="batch-actions">
                <span class="count-chip">@_batch.Ideas.Count / 10 @T.Pick("titluri", "titles")</span>
                @if (!IsTerminal(_batch.Status))
                {
                    <button class="button button-ghost" disabled="@_busy" @onclick="CancelAsync">@T[Copy.Stop]</button>
                }
            </div>
        </header>

        @* The ten spinners are what a batch that is STILL WORKING looks like.
           They were shown on `Ideas.Count == 0` alone until 2026-08-31, so a
           batch that had already failed showed them too — for ever, since a
           finished batch sends no further events. That is what "s-a blocat"
           was: not a hang, a screen that never stopped saying "preparing". *@
        @if (_batch.Ideas.Count == 0 && !IsTerminal(_batch.Status))
        {
            @for (var index = 1; index <= 10; index++)
            {
                <article class="idea-card idea-waiting">
                    <span class="idea-number">@index</span>
                    <div class="idea-title-copy">
                        <strong>@T[Copy.PreparingTitle]</strong>
                        <small>@T[Copy.NanoWorking]</small>
                    </div>
                    <span class="mini-spinner"></span>
                </article>
            }
        }
        else if (_batch.Ideas.Count == 0)
        {
            <section class="batch-empty" role="status">
                <strong>@T[Copy.EmptyBatchHeading]</strong>
                <p>@T[Copy.EmptyBatchBody]</p>
                <button class="button button-primary" type="button"
                        disabled="@_busy" @onclick="RetryBatchAsync">@T[Copy.EmptyBatchRetry]</button>
            </section>
        }
        else
        {
            @foreach (var idea in _batch.Ideas.OrderBy(item => item.Ordinal))
            {
                <article class="idea-card status-@idea.Status">
                    <button class="idea-card-header" type="button" disabled="@(idea.Status == "generating")" @onclick="() => ToggleIdeaAsync(idea)" aria-expanded="@IsExpanded(idea.Id)">
                        <span class="idea-number">@idea.Ordinal</span>
                        <span class="idea-title-copy">
                            <strong>@idea.Title</strong>
                            <small>@Values.FormatLabel(T, _batch.Format) · @Values.PillarLabel(T, _batch.Pillar) · @IdeaStatus(idea)</small>
                        </span>
                        <span class="idea-state">@IdeaStateIcon(idea.Status)</span>
                        <span class="chevron @(IsExpanded(idea.Id) ? "open" : null)">⌄</span>
                    </button>

                    @if (idea.Status == "failed")
                    {
                        <div class="idea-error">
                            @Values.GenerationError(T, idea.LastError)
                            <button class="button button-quiet" type="button" disabled="@_busy" @onclick="() => DevelopAsync(idea)">@T[Copy.DevelopRetry]</button>
                        </div>
                    }

                    @* The details are written when she opens the card, not ten
                       at a time when the batch lands. See `develop` in the
                       generator: they are the whole cost of a run, and she
                       develops one idea. *@
                    @if (idea.Status == "waiting")
                    {
                        <div class="idea-develop">
                            <button class="button button-primary" type="button"
                                    disabled="@_busy" @onclick="() => DevelopAsync(idea)">@T[Copy.DevelopAction]</button>
                            <small>@T[Copy.DevelopActionNote]</small>
                        </div>
                    }
                    @if (idea.Status == "generating")
                    {
                        <div class="idea-waiting-hint" role="status">@T[Copy.DevelopWorking]</div>
                    }

                    @if (IsExpanded(idea.Id) && idea.Status == "ready")
                    {
                        var active = ActiveVariant(idea);
                        <div class="idea-details">
                            <div class="variant-tabs" role="tablist" aria-label="@T[Copy.HookTypesAria]">
                                @foreach (var variant in idea.Variants)
                                {
                                    <button type="button" role="tab" class="@VariantTabClass(idea, variant)" aria-selected="@(active?.Id == variant.Id)" @onclick="() => ActivateVariant(idea, variant)">
                                        @HookLabel(variant.HookType)
                                        @if (variant.IsSelected)
                                        {
                                            <span title="@T[Copy.ChosenVariantTitle]">✓</span>
                                        }
                                    </button>
                                }
                            </div>

                            @if (active is not null)
                            {
                                <div class="variant-content" role="tabpanel">
                                    <section class="content-block hook-block">
                                        <span class="content-label">Hook · @HookLabel(active.HookType)</span>
                                        <p>@active.Hook</p>
                                    </section>
                                    @* A silent reel has no script and no production block.
                                       Rendered on what the variant actually carries rather
                                       than on its format, so the posts written before this
                                       still open with everything they were saved with. *@
                                    @if (!string.IsNullOrWhiteSpace(active.Script))
                                    {
                                        <section class="content-block">
                                            <span class="content-label">@T[Copy.LabelScript]</span>
                                            <p class="preserve-lines">@active.Script</p>
                                        </section>
                                    }
                                    @if (active.FormatDetails is not null)
                                    {
                                        <section class="content-block format-production">
                                            <span class="content-label">@T[Copy.LabelProduction] · @active.FormatDetails.DurationOrCount</span>
                                            <p>@active.FormatDetails.VisualDirection</p>
                                            <ol>
                                                @foreach (var block in active.FormatDetails.ContentBlocks)
                                                {
                                                    <li>@block</li>
                                                }
                                            </ol>
                                        </section>
                                    }
                                    <section class="content-block">
                                        <span class="content-label">@T[Copy.LabelCaption]</span>
                                        <p class="preserve-lines">@active.Caption</p>
                                    </section>
                                    <div class="variant-meta">
                                        <p><strong>@T[Copy.LabelCta]:</strong> @active.Cta</p>
                                        <p><strong>@T[Copy.LabelHashtags]:</strong> @string.Join(" ", active.Hashtags ?? [])</p>
                                        <p><strong>@T[Copy.LabelSource]:</strong> @active.Source</p>
                                    </div>
                                    <button class="button @(active.IsSelected ? "button-selected" : "button-primary")" disabled="@(_busy || active.IsSelected)" @onclick="() => SelectVariantAsync(active)">
                                        @(active.IsSelected ? T[Copy.ChosenVariant] : T[Copy.ChooseVariant])
                                    </button>
                                </div>
                            }
                        </div>
                    }
                </article>
            }
        }
    </section>
}

@if (_batch is not null && SaveCandidates.Count > 0)
{
    <section class="save-panel" aria-label="@T[Copy.SaveAria]">
        <header>
            <div>
                <span class="eyebrow">@T[Copy.ReadyToSave]</span>
                <h2>@T[Copy.FinalPosts]</h2>
                <p>@T[Copy.SaveLede]</p>
            </div>
            <span class="count-chip">@_toSave.Count / @SaveCandidates.Count @T.Pick("bifate", "ticked")</span>
        </header>

        <ul class="save-list">
            @foreach (var candidate in SaveCandidates)
            {
                <li>
                    <label>
                        <input type="checkbox" checked="@_toSave.Contains(candidate.Variant.Id)" @onchange="eventArgs => ToggleSave(candidate.Variant.Id, eventArgs)" />
                        <span>
                            <strong>@candidate.Idea.Title</strong>
                            <small>@HookLabel(candidate.Variant.HookType) · @Values.FormatLabel(T, _batch.Format) · @Values.PillarLabel(T, _batch.Pillar)</small>
                        </span>
                    </label>
                </li>
            }
        </ul>

        <div class="save-actions">
            <span>@T[Copy.NothingWithoutYou]</span>
            <button class="button button-primary" disabled="@(_busy || _toSave.Count == 0)" @onclick="PrepareSaveAsync">
                @(_busy && _saveRun is null
                    ? T[Copy.Preparing]
                    : $"{T[Copy.PrepareSaveShort]} ({_toSave.Count})")
            </button>
        </div>

        @if (_saveRun is not null)
        {
            <ApprovalPanel Run="_saveRun"
                           Busy="_busy"
                           Title="@T[Copy.SaveApprovalTitle]"
                           Message="@T[Copy.SaveApprovalMessage]"
                           RejectLabel="@T[Copy.NotNow]"
                           Summary="SaveSummary"
                           OnDecision="DecideSaveAsync" />
        }

        @if (_saveMessage is not null)
        {
            <div class="notice notice-success" role="status">@_saveMessage</div>
        }
    </section>
}

@code {
    [CascadingParameter(Name = "T")] public Translator T { get; set; } = new("ro");

    private readonly HashSet<string> _expandedIdeas = [];
    private readonly Dictionary<string, string> _activeHooks = [];
    private readonly HashSet<string> _toSave = [];
    private List<LibraryItemDto> _library = [];
    private GenerationBatchDto? _batch;
    private string _source = "Memorie";
    private string _pillar = "Educație";
    private string _format = "Reel";
    // Empty until /api/me answers, and one entry for every account but hers —
    // so the picker is absent by default and appears only when the server has
    // actually offered a choice. A failed read leaves it empty, which sends no
    // model name at all and lets the deployment default stand.
    private List<string> _models = [];
    private string? _model;
    private string? _focus;
    private string? _error;
    private bool _busy;
    private bool _loadingBatch = true;
    private bool _libraryLoading = true;
    private bool _confirmReplace;
    private bool _disposed;
    private RunResponseDto? _saveRun;
    private string? _saveMessage;

    private bool UsesBooks => _source is "Cărți" or "Combinat";

    private bool BooksOnlyWithEmptyShelf =>
        _source == "Cărți" && !_libraryLoading && _library.Count == 0;

    /// <summary>One chosen, ready variant per idea — the only things savable.</summary>
    private List<SaveCandidate> SaveCandidates =>
        _batch is null
            ? []
            : _batch.Ideas
                .OrderBy(idea => idea.Ordinal)
                .Select(idea => new
                {
                    Idea = idea,
                    Variant = idea.Variants.FirstOrDefault(
                        variant => variant.IsSelected && variant.Status == "ready")
                })
                .Where(entry => entry.Variant is not null)
                .Select(entry => new SaveCandidate(entry.Idea, entry.Variant!))
                .ToList();

    private List<string> SaveSummary => SaveCandidates
        .Where(candidate => _toSave.Contains(candidate.Variant.Id))
        .Select(candidate => $"{candidate.Idea.Title} · {HookLabel(candidate.Variant.HookType)}")
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        Events.EventReceived += OnGenerationEventAsync;
        Events.ActivityReceived += OnGenerationActivityAsync;
        Events.ConnectionInterrupted += OnConnectionInterruptedAsync;
        ContextState.GenerationPatched += OnGenerationPatchedAsync;
        ContextState.ConversationReset += OnConversationResetAsync;
        await Task.WhenAll(LoadLibraryAsync(), LoadCurrentAsync(), LoadModelsAsync());
    }

    /// <summary>Which models this account may pick between, if more than one.</summary>
    private async Task LoadModelsAsync()
    {
        try
        {
            _models = (await Api.GetMeAsync()).Models;
            _model = _models.FirstOrDefault();
        }
        catch (Exception)
        {
            // Deliberately silent, and deliberately not `_error`. The picker is
            // an extra; failing to learn about it must not put a red banner over
            // a generator that works perfectly on the default model.
            _models = [];
            _model = null;
        }
    }

    private async Task LoadLibraryAsync()
    {
        try
        {
            _library = (await Api.GetLibraryAsync()).Items;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _libraryLoading = false;
        }
    }

    private async Task LoadCurrentAsync()
    {
        try
        {
            _batch = (await Api.GetCurrentGenerationAsync()).Batch;
            await WatchAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loadingBatch = false;
        }
    }

    /// <summary>Run the failed batch's own request again.</summary>
    /// <remarks>
    /// The three selects are set from the batch before starting, not read from:
    /// they hold their defaults until she touches them, so a retry that used
    /// them would quietly generate something else than the lot she is looking at.
    /// </remarks>
    private async Task RetryBatchAsync()
    {
        if (_batch is null)
        {
            return;
        }

        _source = _batch.Source;
        _pillar = _batch.Pillar;
        _format = _batch.Format;
        _focus = _batch.Focus ?? string.Empty;
        await StartAsync(true);
    }

    private async Task StartAsync(bool replace)
    {
        if (_batch is not null && !replace)
        {
            _confirmReplace = true;
            return;
        }

        _busy = true;
        _error = null;
        _confirmReplace = false;
        try
        {
            var envelope = await Api.StartGenerationAsync(new GenerationStartDto
            {
                Format = _format,
                Pillar = _pillar,
                Source = _source,
                Focus = _focus,
                // Null unless a picker was actually drawn, which keeps every
                // other account sending exactly what it sent before.
                Model = _models.Count > 1 ? _model : null,
                ReplaceCurrent = replace
            });
            _batch = envelope.Batch;
            _expandedIdeas.Clear();
            _activeHooks.Clear();
            if (_batch is not null)
            {
                await Events.ConnectAsync(Api.GenerationEventsUrl(_batch.Id));
            }
            // The press was dictated into the conversation; an open drawer
            // should show the sentence now, not at its next opening.
            await ContextState.NotifyConversationChangedAsync();
        }
        catch (StudioApiException ex) when (ex.StatusCode == 409)
        {
            _confirmReplace = true;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RefreshBatchAsync()
    {
        if (_batch is not null)
        {
            _batch = (await Api.GetGenerationAsync(_batch.Id)).Batch;
            // A variant she un-chose, or one a rewrite reset, must not stay
            // silently ticked in a save she is about to confirm.
            var savable = SaveCandidates.Select(candidate => candidate.Variant.Id).ToHashSet();
            _toSave.RemoveWhere(id => !savable.Contains(id));
        }
    }

    private async Task OnGenerationEventAsync(string eventType)
    {
        if (_disposed)
        {
            return;
        }
        await InvokeAsync(async () =>
        {
            try
            {
                await RefreshBatchAsync();
                if (eventType == "idea.ready" && _batch is not null)
                {
                    var firstReady = _batch.Ideas.FirstOrDefault(idea => idea.Status == "ready");
                    if (firstReady is not null && _expandedIdeas.Count == 0)
                    {
                        _expandedIdeas.Add(firstReady.Id);
                        SetChatTarget(firstReady);
                    }
                }
                if (eventType is "titles.ready" or "idea.ready" or "idea.failed"
                    or "completed" or "error")
                {
                    await ContextState.NotifyConversationChangedAsync();
                }
            }
            catch (Exception ex)
            {
                _error = ex.Message;
            }
            StateHasChanged();
        });
    }

    // Deliberately NOT a batch refresh. Every other event on this stream means
    // "something changed, go and read it"; an errand is the thing itself, and
    // refreshing for each one would be an HTTP round trip per tool call.
    private Task OnGenerationActivityAsync(string payload)
    {
        if (_disposed)
        {
            return Task.CompletedTask;
        }
        return ContextState.NotifyGenerationActivityAsync(payload);
    }

    private Task OnConversationResetAsync()
    {
        if (_disposed)
        {
            return Task.CompletedTask;
        }
        return InvokeAsync(async () =>
        {
            // A fresh conversation retired the lot on the server; the page
            // follows. `LoadCurrentAsync` confirms there is nothing current.
            await Events.DisconnectAsync();
            if (_batch is not null)
            {
                ContextState.ClearGenerationVariant(_batch.Id);
            }
            _batch = null;
            _expandedIdeas.Clear();
            _activeHooks.Clear();
            _toSave.Clear();
            _error = null;
            await LoadCurrentAsync();
            StateHasChanged();
        });
    }

    private Task OnConnectionInterruptedAsync()
    {
        if (_disposed || _batch is null || IsTerminal(_batch.Status))
        {
            return Task.CompletedTask;
        }
        return InvokeAsync(() =>
        {
            _error = T[Copy.LiveReconnected];
            StateHasChanged();
        });
    }

    private async Task CancelAsync()
    {
        if (_batch is null)
        {
            return;
        }
        _busy = true;
        try
        {
            await Api.CancelGenerationAsync(_batch.Id);
            await Events.DisconnectAsync();
            await RefreshBatchAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SelectVariantAsync(GenerationVariantDto variant)
    {
        _busy = true;
        try
        {
            await Api.SelectVariantAsync(variant.Id);
            await RefreshBatchAsync();
            _toSave.Add(variant.Id);
            _saveMessage = null;
            // The click was dictated into the conversation as her sentence.
            await ContextState.NotifyConversationChangedAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }


    private void ToggleSave(string variantId, ChangeEventArgs eventArgs)
    {
        if (eventArgs.Value is true)
        {
            _toSave.Add(variantId);
        }
        else
        {
            _toSave.Remove(variantId);
        }
        _saveRun = null;
    }

    private async Task PrepareSaveAsync()
    {
        _busy = true;
        _error = null;
        _saveMessage = null;
        _saveRun = null;
        try
        {
            _saveRun = await Api.PrepareBatchSaveAsync(_toSave);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DecideSaveAsync(bool approved)
    {
        if (_saveRun is null)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            var result = await Api.DecideAsync(_saveRun, approved);
            _saveRun = null;
            if (approved && result.Status == "completed")
            {
                _saveMessage = T.Pick(
                    $"Am salvat {Values.Posts(T, _toSave.Count)}. "
                        + (_toSave.Count == 1
                            ? "O găsești în „Salvate”."
                            : "Le găsești în „Salvate”."),
                    $"Saved {Values.Posts(T, _toSave.Count)}. "
                        + (_toSave.Count == 1
                            ? "You will find it under “Saved”."
                            : "You will find them under “Saved”."));
                _toSave.Clear();
            }
            else
            {
                _saveMessage = T[Copy.SaveCancelled];
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ToggleIdeaAsync(GenerationIdeaDto idea)
    {
        if (_expandedIdeas.Remove(idea.Id))
        {
            return;
        }

        _expandedIdeas.Add(idea.Id);
        SetChatTarget(idea);
        // OPENING A CARD NO LONGER BUYS ONE. It did until 2026-08-31, and the
        // only thing that said so was a line of grey text underneath - so a
        // header that looked like every other expander spent a model call. The
        // click that costs money is now a button that says what it does; this
        // one just opens the card. `DevelopAsync` is still idempotent and the
        // server still refuses a second buy, but neither is the reason: the
        // reason is that she should be able to look without paying.
        await Task.CompletedTask;
    }

    private async Task DevelopAsync(GenerationIdeaDto idea)
    {
        if (_batch is null)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            // Optimistic, so the card reacts on the click rather than on the
            // round trip. The server is the authority and the event stream
            // corrects this within a second either way.
            idea.Status = "generating";
            await Api.DevelopGenerationIdeaAsync(_batch.Id, idea.Ordinal);
            // The batch is `ready` by now on every idea after the first few, so
            // the stream from page load is closed or was never opened. Without
            // this the card writes in silence and only a reload shows the result.
            await WatchAsync();
            // The click was dictated into the conversation as her sentence.
            await ContextState.NotifyConversationChangedAsync();
        }
        catch (Exception ex)
        {
            idea.Status = "waiting";
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>Open the event stream when there is anything left to report.</summary>
    /// <remarks>
    /// NOT `!IsTerminal(status)`, which is what this was until 2026-08-31. A
    /// batch turns `ready` while nine ideas are still undeveloped, and she
    /// develops them one at a time from that state - so the condition that
    /// decides whether to watch has to look at the ideas, not at the word on
    /// the batch. `ConnectAsync` disconnects first, so calling it again is how
    /// a stream is re-opened rather than doubled.
    /// </remarks>
    private async Task WatchAsync()
    {
        if (_batch is null)
        {
            return;
        }
        var working = !IsTerminal(_batch.Status)
            || _batch.Ideas.Any(idea => idea.Status is "generating" or "retrying");
        if (working)
        {
            await Events.ConnectAsync(Api.GenerationEventsUrl(_batch.Id));
        }
    }

    private bool IsExpanded(string id) => _expandedIdeas.Contains(id);

    private GenerationVariantDto? ActiveVariant(GenerationIdeaDto idea)
    {
        var hook = _activeHooks.GetValueOrDefault(idea.Id);
        return idea.Variants.FirstOrDefault(item => item.HookType == hook)
            ?? idea.Variants.FirstOrDefault(item => item.IsSelected)
            ?? idea.Variants.FirstOrDefault();
    }

    private void ActivateVariant(GenerationIdeaDto idea, GenerationVariantDto variant)
    {
        _activeHooks[idea.Id] = variant.HookType;
        if (_batch is not null)
        {
            ContextState.SetGenerationVariant(
                _batch.Id, idea.Id, idea.Title, variant);
        }
    }

    private void SetChatTarget(GenerationIdeaDto idea)
    {
        var variant = ActiveVariant(idea);
        if (_batch is not null && variant is not null)
        {
            ContextState.SetGenerationVariant(
                _batch.Id, idea.Id, idea.Title, variant);
        }
    }

    private async Task OnGenerationPatchedAsync(string variantId)
    {
        await InvokeAsync(async () =>
        {
            await RefreshBatchAsync();
            if (_batch is not null)
            {
                var idea = _batch.Ideas.FirstOrDefault(item =>
                    item.Variants.Any(variant => variant.Id == variantId));
                if (idea is not null)
                {
                    var variant = idea.Variants.First(item => item.Id == variantId);
                    ContextState.SetGenerationVariant(
                        _batch.Id, idea.Id, idea.Title, variant);
                }
            }
            StateHasChanged();
        });
    }

    private string VariantTabClass(GenerationIdeaDto idea, GenerationVariantDto variant) =>
        ActiveVariant(idea)?.Id == variant.Id ? "active" : "";

    private static bool IsTerminal(string status) =>
        status is "ready" or "failed" or "cancelled" or "replaced";

    private string HookLabel(string value) => Values.HookLabel(T, value);

    private static string IdeaStateIcon(string status) => status switch
    {
        "ready" => "✓",
        "failed" => "!",
        "cancelled" => "×",
        _ => "·"
    };

    private string IdeaStatus(GenerationIdeaDto idea) =>
        Values.IdeaStatus(T, idea.Status, idea.RetryCount);

    private string BatchStatus(GenerationBatchDto batch) => Values.BatchStatus(
        T,
        batch.Status,
        batch.Ideas.Count(idea => idea.Status == "ready"),
        batch.Ideas.Count);

    private sealed record SaveCandidate(
        GenerationIdeaDto Idea, GenerationVariantDto Variant);

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Events.EventReceived -= OnGenerationEventAsync;
        Events.ActivityReceived -= OnGenerationActivityAsync;
        Events.ConnectionInterrupted -= OnConnectionInterruptedAsync;
        ContextState.GenerationPatched -= OnGenerationPatchedAsync;
        ContextState.ConversationReset -= OnConversationResetAsync;
        if (_batch is not null)
        {
            ContextState.ClearGenerationVariant(_batch.Id);
        }
        await Events.DisconnectAsync();
    }
}
