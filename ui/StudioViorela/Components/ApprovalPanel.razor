@if (Run is not null)
{
    <section class="approval-panel" aria-live="polite">
        <div class="approval-icon">✓</div>
        <div class="approval-copy">
            <span class="eyebrow">@T[Copy.ApprovalEyebrow]</span>
            <h3>@(Title ?? T[Copy.ApprovalDefaultTitle])</h3>
            <p>@(Message ?? T[Copy.ApprovalDefaultMessage])</p>
            @if (Summary.Count > 0)
            {
                <ul class="approval-summary">
                    @foreach (var line in Summary)
                    {
                        <li>@line</li>
                    }
                </ul>
            }
        </div>
        <div class="approval-actions">
            <button class="button button-ghost" disabled="@Busy" @onclick="() => OnDecision.InvokeAsync(false)">
                @(RejectLabel ?? T[Copy.Cancel])
            </button>
            <button class="button button-primary" disabled="@Busy" @onclick="() => OnDecision.InvokeAsync(true)">
                @(Busy ? T[Copy.Applying] : T[Copy.Confirm])
            </button>
        </div>
    </section>
}

@code {
    [CascadingParameter(Name = "T")] public Translator T { get; set; } = new("ro");

    [Parameter, EditorRequired] public RunResponseDto? Run { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<bool> OnDecision { get; set; }

    // Null rather than a Romanian literal: the default has to follow the
    // language, and a default baked in here would not.
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Message { get; set; }
    [Parameter] public string? RejectLabel { get; set; }
    [Parameter] public List<string> Summary { get; set; } = [];
}
