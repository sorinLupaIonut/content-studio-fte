@implements IAsyncDisposable
@using System.Text.Json
@inject StudioApiClient Api
@inject ChatEventStream Events
@inject StudioContextState ContextState

<button class="chat-launcher" type="button" @onclick="ToggleAsync" aria-expanded="@_open" aria-label="@T[Copy.ChatLauncher]" title="@T[Copy.ChatLauncher]">
    <span aria-hidden="true">✦</span>
    <span>@T[Copy.ChatLauncher]</span>
</button>

@if (_open)
{
    <aside class="chat-drawer" aria-label="@T[Copy.ChatAria]">
        <header>
            <div>
                <span class="eyebrow">@T[Copy.ChatEyebrow]</span>
                <h2>@T[Copy.ChatHeading]</h2>
            </div>
            <div class="chat-header-actions">
                <button class="button button-quiet" type="button" disabled="@_busy"
                        title="@T[Copy.ChatNewConversationHint]"
                        @onclick="NewConversationAsync">@T[Copy.ChatNewConversation]</button>
                <button class="icon-button" type="button" @onclick="ToggleAsync" aria-label="@T[Copy.ChatClose]">×</button>
            </div>
        </header>
        <div class="chat-context" title="@ContextState.Target.Label">
            <span class="status-dot"></span>
            <span>@T[Copy.ChatContext]: @ContextState.Target.Label</span>
        </div>

        <div class="chat-messages" aria-live="polite">
            @if (_messages.Count == 0)
            {
                <div class="chat-empty">
                    <span class="chat-spark">✦</span>
                    <strong>@T[Copy.ChatEmptyTitle]</strong>
                    <p>@T[Copy.ChatEmptyBody]</p>
                </div>
            }
            @foreach (var message in _messages)
            {
                @if (message.Role == "tool")
                {
                    <details class="chat-tool">
                        <summary>🔧 @message.ToolName</summary>
                        <pre>@message.Text@(string.IsNullOrEmpty(message.Detail) ? "" : "\n→ " + message.Detail)</pre>
                    </details>
                }
                else
                {
                <article class="chat-message chat-@message.Role @(message.Error ? "chat-error" : null)">
                    <span>@(message.Role == "user" ? T[Copy.ChatYou] : T[Copy.ChatAgent])</span>
                    <p class="preserve-lines">
                        @message.Text
                        @if (message.Streaming)
                        {
                            <span class="stream-caret" aria-label="@T[Copy.ChatStreaming]"></span>
                        }
                    </p>
                    @if (message.Stopped)
                    {
                        <small>@T[Copy.ChatStopped]</small>
                    }
                    else if (message.Patched)
                    {
                        <small>
                            @(message.PatchIsDraft
                                ? T[Copy.ChatPostRewritten]
                                : T[Copy.ChatVariantUpdated])
                        </small>
                    }
                </article>
                }
            }

            @* Live, and never stored. A generation run is silent until it lands
               - the conversation is told afterwards - and this is the ninety
               seconds in between. The rows clear the moment the real message
               arrives, so nothing is ever shown twice. *@
            @if (_activity.Count > 0)
            {
                <div class="chat-activity" role="status">
                    <small>@T[Copy.ActivityHeading]</small>
                    @foreach (var line in _activity)
                    {
                        <div class="chat-activity-row @(line.Done ? "done" : null)">
                            <span class="chat-activity-mark">@(line.Done ? "✓" : "·")</span>
                            <span>@Values.ActivityLabel(T, line.Code)</span>
                            @if (line.Done && line.Empty)
                            {
                                <em>@T[Copy.ActivityEmpty]</em>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        @if (_connectionNote is not null)
        {
            <div class="chat-connection-note" role="status">@_connectionNote</div>
        }

        <footer class="chat-composer">
            <textarea @bind="_draft" disabled="@_busy" placeholder="@T[Copy.ChatPlaceholder]"></textarea>
            <div>
                <button class="icon-button" disabled title="@T[Copy.ChatAttachments]">＋</button>
                <button class="icon-button" disabled title="@T[Copy.ChatMicrophone]">◉</button>
                @if (_busy)
                {
                    <button class="send-button stop-button" @onclick="StopAsync">@T[Copy.Stop]</button>
                }
                else
                {
                    <button class="send-button" disabled="@string.IsNullOrWhiteSpace(_draft)" @onclick="SendAsync">@T[Copy.ChatSend]</button>
                }
            </div>
        </footer>
    </aside>
    <button class="drawer-scrim" type="button" @onclick="ToggleAsync" aria-label="@T[Copy.ChatClose]"></button>
}

@code {
    [CascadingParameter(Name = "T")] public Translator T { get; set; } = new("ro");

    private readonly List<ChatMessageView> _messages = [];
    private string _draft = "";
    private string? _runId;
    private string? _connectionNote;
    private bool _open;
    private bool _busy;
    private bool _disposed;
    private readonly List<ActivityRow> _activity = [];

    protected override void OnInitialized()
    {
        Events.EventReceived += OnEventAsync;
        Events.ConnectionInterrupted += OnInterruptedAsync;
        ContextState.Changed += OnContextChanged;
        ContextState.ConversationChanged += OnConversationChangedAsync;
        ContextState.GenerationActivity += OnGenerationActivityAsync;
    }

    // READ WITH `JsonDocument`, NOT `Deserialize<T>`. Blazor publishes trimmed,
    // and reflection-based deserialisation into a type nothing else references
    // loses its properties to the trimmer - silently, and in a way that looks
    // like a feature half working rather than one that never read its input.
    // Measured on 2026-08-31: every row rendered as the fallback word and none
    // was ever ticked off, because `Code` and `State` came back null. There is
    // no `[JsonSerializable]` context in this project to add these to, and four
    // fields do not need one.
    private Task OnGenerationActivityAsync(string payload)
    {
        if (_disposed)
        {
            return Task.CompletedTask;
        }
        return InvokeAsync(() =>
        {
            try
            {
                using var document = JsonDocument.Parse(payload);
                // The frame, then the errand: `encode_sse` wraps every event.
                if (!document.RootElement.TryGetProperty("payload", out var line))
                {
                    return;
                }
                var state = line.TryGetProperty("state", out var s) ? s.GetString() : null;
                if (state == "done")
                {
                    // `of` names the row this finishes. An unknown one means the
                    // drawer opened mid-run and never saw the start — drop it
                    // rather than draw a tick with nothing above it.
                    var of = line.TryGetProperty("of", out var o) ? o.GetInt32() : 0;
                    var started = _activity.FirstOrDefault(row => row.Seq == of);
                    if (started is not null)
                    {
                        started.Done = true;
                        started.Empty = line.TryGetProperty("empty", out var e)
                            && e.ValueKind == JsonValueKind.True;
                    }
                }
                else
                {
                    _activity.Add(new ActivityRow
                    {
                        Seq = line.TryGetProperty("seq", out var q) ? q.GetInt32() : 0,
                        Code = line.TryGetProperty("code", out var c) ? c.GetString() : null
                    });
                }
            }
            catch (JsonException)
            {
                // Decoration on a working page. A malformed line is not worth an
                // error in her chat.
            }
            StateHasChanged();
        });
    }

    private async Task ToggleAsync()
    {
        _open = !_open;
        if (_open)
        {
            await LoadTranscriptAsync();
        }
    }

    // The window IS the agent's session: the drawer shows what the server
    // stored, verbatim, so what you read here is what the model received.
    private async Task LoadTranscriptAsync()
    {
        if (_busy)
        {
            return;
        }
        try
        {
            var transcript = await Api.GetConversationAsync();
            _messages.Clear();
            foreach (var item in transcript.Items)
            {
                _messages.Add(item.Kind == "tool"
                    ? new ChatMessageView("tool", item.Text)
                    {
                        ToolName = item.Name ?? "?",
                        Detail = item.Detail
                    }
                    : new ChatMessageView(item.Kind, item.Text)
                    {
                        Detail = item.Detail
                    });
            }
            _connectionNote = null;
        }
        catch (Exception)
        {
            _connectionNote = T[Copy.ChatHistoryError];
        }
        StateHasChanged();
    }

    private async Task NewConversationAsync()
    {
        if (_busy)
        {
            return;
        }
        try
        {
            await Api.NewConversationAsync();
            _messages.Clear();
            _connectionNote = null;
            await ContextState.NotifyConversationResetAsync();
        }
        catch (Exception ex)
        {
            _connectionNote = ex.Message;
        }
        StateHasChanged();
    }

    private Task OnConversationChangedAsync()
    {
        if (_disposed)
        {
            return Task.CompletedTask;
        }
        // The witnessed message is what the errands were standing in for, so
        // they go when it arrives. Cleared even with the drawer shut: a run
        // watched from behind a closed drawer would otherwise leave its rows to
        // greet her the next time she opens it, describing work long finished.
        _activity.Clear();
        if (!_open)
        {
            return Task.CompletedTask;
        }
        return InvokeAsync(LoadTranscriptAsync);
    }

    private async Task SendAsync()
    {
        var text = _draft.Trim();
        if (_busy || text.Length == 0)
        {
            return;
        }

        var target = new ChatTargetDto
        {
            Kind = ContextState.Target.Kind,
            Id = ContextState.Target.Id,
            BatchId = ContextState.Target.BatchId,
            IdeaId = ContextState.Target.IdeaId,
            Label = ContextState.Target.Label
        };
        _draft = "";
        _connectionNote = null;
        _messages.Add(new ChatMessageView("user", text));
        _messages.Add(new ChatMessageView("assistant", "") { Streaming = true });
        _busy = true;
        try
        {
            var run = await Api.StartChatAsync(new ChatStartDto
            {
                Message = text,
                Target = target
            });
            _runId = run.RunId;
            await Events.ConnectAsync(Api.ChatEventsUrl(run.RunId));
        }
        catch (Exception ex)
        {
            FinishAssistant(error: ex.Message);
        }
    }

    private async Task StopAsync()
    {
        if (_runId is null)
        {
            return;
        }
        try
        {
            await Api.CancelChatAsync(_runId);
            _connectionNote = T[Copy.ChatStopping];
        }
        catch (Exception ex)
        {
            _connectionNote = ex.Message;
        }
    }

    private Task OnEventAsync(string eventType, string data)
    {
        if (_disposed)
        {
            return Task.CompletedTask;
        }
        return InvokeAsync(async () =>
        {
            var envelope = JsonSerializer.Deserialize<StudioStreamEventDto>(data);
            if (envelope is null)
            {
                return;
            }
            var assistant = _messages.LastOrDefault(item => item.Role == "assistant");
            switch (eventType)
            {
                case "text.delta":
                    if (assistant is not null && envelope.Payload.TryGetProperty("delta", out var delta))
                    {
                        assistant.Text += delta.GetString();
                    }
                    break;
                case "ui.patch":
                    if (assistant is not null)
                    {
                        assistant.Patched = true;
                        assistant.PatchIsDraft = envelope.Payload.TryGetProperty("persisted", out var persisted)
                            && persisted.ValueKind == JsonValueKind.False;
                    }
                    if (envelope.Payload.TryGetProperty("target_id", out var targetId))
                    {
                        var id = targetId.GetString() ?? "";
                        var kind = envelope.Payload.TryGetProperty("target_kind", out var targetKind)
                            ? targetKind.GetString()
                            : "generation_variant";
                        if (kind == "saved_post" && envelope.Payload.TryGetProperty("content", out var content))
                        {
                            await ContextState.NotifySavedPostPatchedAsync(id, content.Clone());
                        }
                        else
                        {
                            await ContextState.NotifyGenerationPatchedAsync(id);
                        }
                    }
                    break;
                case "completed":
                    FinishAssistant();
                    break;
                case "cancelled":
                    FinishAssistant(stopped: true);
                    break;
                case "approval.required":
                    FinishAssistant(error: T[Copy.ChatNeedsApproval]);
                    break;
                case "error":
                    var detail = envelope.Payload.TryGetProperty("detail", out var error)
                        ? error.GetString()
                        : T[Copy.ChatUnfinished];
                    FinishAssistant(error: detail);
                    break;
            }
            StateHasChanged();
        });
    }

    private Task OnInterruptedAsync()
    {
        if (_disposed || !_busy)
        {
            return Task.CompletedTask;
        }
        return InvokeAsync(() =>
        {
            _connectionNote = T[Copy.ChatReconnecting];
            StateHasChanged();
        });
    }

    private void FinishAssistant(bool stopped = false, string? error = null)
    {
        var assistant = _messages.LastOrDefault(item => item.Role == "assistant");
        if (assistant is not null)
        {
            assistant.Streaming = false;
            assistant.Stopped = stopped;
            if (error is not null)
            {
                assistant.Error = true;
                assistant.Text = string.IsNullOrWhiteSpace(assistant.Text)
                    ? error
                    : $"{assistant.Text}\n\n{error}";
            }
        }
        _busy = false;
        _runId = null;
        _connectionNote = null;
    }

    private void OnContextChanged()
    {
        if (!_disposed)
        {
            _ = InvokeAsync(StateHasChanged);
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Events.EventReceived -= OnEventAsync;
        Events.ConnectionInterrupted -= OnInterruptedAsync;
        ContextState.Changed -= OnContextChanged;
        ContextState.ConversationChanged -= OnConversationChangedAsync;
        ContextState.GenerationActivity -= OnGenerationActivityAsync;
        await Events.DisconnectAsync();
    }

    /// <summary>One errand as it is drawn: a start, later ticked off.</summary>
    private sealed class ActivityRow
    {
        public int Seq { get; set; }
        public string? Code { get; set; }
        public bool Done { get; set; }
        public bool Empty { get; set; }
    }

    private sealed class ChatMessageView(string role, string text)
    {
        public string Role { get; } = role;
        public string Text { get; set; } = text;
        public string ToolName { get; set; } = "";
        public string? Detail { get; set; }
        public bool Streaming { get; set; }
        public bool Stopped { get; set; }
        public bool Patched { get; set; }
        public bool PatchIsDraft { get; set; }
        public bool Error { get; set; }
    }
}
