# Copiază fișierul ăsta în `.env` și completează valorile.
# `.env` nu ajunge niciodată pe git — vezi .gitignore.

# Decizia 0 — obligatoriu
OPENAI_API_KEY=sk-...

# Decizia 0 — opțional; implicit gpt-5-mini (vezi §0 din plan pentru de ce nu nano)
MODEL=gpt-5-mini

# Decizia 3 — Neon Postgres. Forma cu `+asyncpg` e obligatorie pentru SQLAlchemySession.
# Pe endpoint-ul pooled: statement_cache_size=0, altfel asyncpg sparge prepared statements.
DATABASE_URL=postgresql+asyncpg://user:parola@host.neon.tech/dbname?sslmode=require
