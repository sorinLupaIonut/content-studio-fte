# Copy this file to `.env` and fill in the values.
# `.env` never reaches git — see .gitignore.

# Decision 0 — required
OPENAI_API_KEY=sk-...

# Decision 0 — optional; defaults to gpt-5-mini
MODEL=gpt-5-mini

# Optional; defaults to the same MODEL for the web search too.
# WEB_SEARCH_MODEL=gpt-5-mini

# D1b generator: the accepted cheap/robust split. This does not change the CLI.
GENERATION_TITLE_MODEL=gpt-5-nano
GENERATION_DETAIL_MODEL=gpt-5-mini
GENERATION_CONCURRENCY=5
CHAT_MODEL=gpt-5-mini

# Decision 3 — Neon Postgres. Paste the string from the Neon console as it comes,
# `sslmode=require` and all: config.py normalizes it for asyncpg.
#
# The POOLED endpoint (host contains `-pooler`). This is what the app uses.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Deployment D4 — the DIRECT endpoint: the same string with `-pooler` removed
# from the host. In the Neon console, the one with "Connection pooling" off.
# Used ONLY by db.apply and db.migrate; the app never touches it. Without it,
# those two refuse to run DDL rather than send it through PgBouncer.
DATABASE_URL_DIRECT=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# Decision 4 — the E2B sandbox. Key from your own account (https://e2b.dev, free Hobby tier).
E2B_API_KEY=e2b_...

# Decision 6 — the `content-data` MCP server. Optional: these are also the defaults.
# MCP_HOST=127.0.0.1
# MCP_PORT=8765
# MCP_URL=http://127.0.0.1:8765/mcp
# MCP_TIMEOUT=90

# Deployment D1 — FastAPI harness. Azure supplies PORT; these are local defaults.
# HARNESS_HOST=0.0.0.0
# HARNESS_PORT=8000

# D1b authentication. Production uses `azure` and values injected as secrets or
# environment configuration. Never commit real email addresses or principal ids.
AUTH_MODE=azure
# The allowlist, and the only real access control: Easy Auth sits behind Google,
# so the first door admits any Google account. Exact, lowercase matching.
# To add or remove a tester, edit this line and run `pwsh infra/deploy.ps1
# -SkipBuild` - a new revision on the same image, no rebuild.
# AUTH_ALLOWED_EMAILS=first@example.com,second@example.com
# Preferred once both identities have signed in once: a subject id cannot be
# re-pointed at a different person the way an address can. When this is set the
# email list above is ignored entirely - migrate both together.
# AUTH_ALLOWED_PRINCIPAL_IDS=google-principal-1,google-principal-2

# Deployment D3 — the Google OAuth client that Easy Auth sits behind. Created by
# hand in Google Cloud Console; Azure cannot mint these. `enable-auth.ps1` prints
# the exact redirect URI to register on its first run, then reads these on the
# second. Not used outside deployment: the app never sees them.
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=...

# Local-only values. Development mode refuses non-loopback binding and refuses
# to run when Azure environment markers are present.
# AUTH_MODE=development
# AUTH_DEV_PRINCIPAL_ID=local-sorin
# AUTH_DEV_EMAIL=local@studio.invalid
# UI_DEV_ORIGINS=http://127.0.0.1:5178,http://localhost:5178

# Decision 7, surface 4 — Phoenix. Optional: without these the agent's own steps
# stay in public.traces, which is the durable record either way. From a Phoenix
# Cloud space: Settings -> API keys. The endpoint may be given with or without
# the /v1/traces suffix.
# PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com/s/<space>/v1/traces
# PHOENIX_API_KEY=...
# PHOENIX_PROJECT_NAME=studio-viorela
