# secrets
.env
# ...and every sibling of it: backups, per-environment copies, whatever a
# future hurry produces. A plain `.env` line does not match `.env.backup`,
# and an untracked file full of live keys is one `git add -A` from public.
.env.*
!.env.example

# python
.venv/
__pycache__/
*.py[cod]

# The books stay local only. They are published volumes under copyright — they do
# not belong in a repository, not even a private one. They are raw material for
# Decision 5: once chunked and embedded, their truth lives in Neon. The README
# stays tracked, so the inventory of the corpus is visible without the text.
content/books/pdf/
content/books/txt/
content/books/md/*.md
!content/books/md/README.md

# the model's output from the last eval run; the runner and the cases stay in Git
evals/report-latest.json
evals/raport-latest.json

# Blazor build and publish output
ui/**/bin/
ui/**/obj/
ui/**/dist/

# Visual Studio per-user workspace state. The editor writes these next to the
# solution and next to the project; nothing in them is shared work.
.vs/

# Personal Claude Code overrides (e.g. bypassPermissions) - not shared with the team.
.claude/settings.local.json
