{
  // D1: the two long-running services used during local development.
  // Secrets stay in `.env`; this committed file never contains keys.
  "version": "0.2.0",
  "configurations": [
    {
      // Internal business-data service. Start this before the harness.
      "name": "MCP server",
      "type": "debugpy",
      "request": "launch",
      "module": "content_studio.mcp_server.server",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      // Uvicorn serves the FastAPI object `app` from harness/main.py.
      // No --reload: it creates a child process that makes debugger ownership
      // and breakpoints less predictable.
      "name": "FastAPI harness",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "content_studio.harness.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ],
  "compounds": [
    {
      // Select this one to start both debug sessions concurrently with one F5.
      // The harness may boot before MCP; /health reports degraded until MCP is ready.
      "name": "MCP + Harness",
      "configurations": ["MCP server", "FastAPI harness"],
      "stopAll": true
    }
  ]
}
