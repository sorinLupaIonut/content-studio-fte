{
  // Rewritten on 2026-08-24. Every configuration here is `launch`: the editor
  // starts the process itself, so the code under the debugger is the code on
  // disk and breakpoints cannot fail to bind.
  //
  // The attach configurations that used to live here are gone. They cost a
  // full afternoon: the selected one was "Attach: harness (container)", whose
  // `pathMappings` rewrote every breakpoint path to /app/src — a filesystem
  // that does not exist in a local process — so every breakpoint in every file
  // went hollow while the connection itself succeeded. Nothing reported an
  // error. `git show <commit>:.vscode/launch.json` has them if a container ever
  // needs debugging.
  //
  // Secrets stay in `.env`; this committed file never contains keys.
  "version": "0.2.0",
  "configurations": [
    {
      // START HERE for anything about the prompt. No database, no MCP, no
      // OpenAI call, no cost. Stops inside `build_worker` in under a second.
      "name": "1. Prompt (build_worker)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tests/checks/safe/prompt.py",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "pythonArgs": ["-X", "frozen_modules=off"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      // The one place justMyCode is false, so you can step into the SDK.
      "justMyCode": false
    },
    {
      // Business data. The harness needs it, so it starts first in the compound.
      "name": "2. MCP server",
      "type": "debugpy",
      "request": "launch",
      "module": "content_studio.mcp_server.server",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "pythonArgs": ["-X", "frozen_modules=off"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      // FastAPI. No --reload: a reloader forks, and the debugger then owns the
      // parent while the code runs in the child.
      //
      // Importing this raises ~130k exceptions inside Pydantic and FastAPI, all
      // caught and all normal. They are only expensive if the debugger stops to
      // inspect them, so leave every entry in the BREAKPOINTS panel's exception
      // section unticked. With them off, startup is ordinary.
      "name": "3. Harness (FastAPI)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "content_studio.harness.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "pythonArgs": ["-X", "frozen_modules=off"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "AUTH_MODE": "development",
        "HARNESS_HOST": "127.0.0.1",
        // Silences debugpy's frozen-modules warning; the -X flag above is the
        // actual fix, this only stops the message that looks like an error.
        "PYDEVD_DISABLE_FILE_VALIDATION": "1"
      },
      "justMyCode": true
    },
    {
      // The Blazor host. Deliberately `node-terminal`, not `coreclr`: the app
      // runs in the browser's WebAssembly runtime, where a .NET debugger on this
      // side cannot reach it. This just runs the command and stops with the
      // compound. Debug the C# from the browser's own devtools.
      "name": "4. Blazor UI",
      "type": "node-terminal",
      "request": "launch",
      "command": "dotnet run --project ui/StudioViorela/StudioViorela.csproj --no-launch-profile --urls http://127.0.0.1:5178",
      "cwd": "${workspaceFolder}",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Now listening on:\\s+(https?://\\S+)"
      }
    },
    {
      // The free suite under the debugger. Breakpoint in a failing test and
      // start here instead of reading the traceback.
      "name": "5. Unit tests",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["discover", "-s", "tests/unit"],
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "pythonArgs": ["-X", "frozen_modules=off"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      // COSTS MONEY, and it is the only configuration here that does: one real
      // generation run, the same call the "Generare" button makes, with the
      // container and the model. Start "2. MCP server" first, and leave it
      // running: this reads the profile over MCP before it reaches OpenAI, and
      // the agent then calls `search_books` / `search_web` back through the same
      // connection while it works. Nothing else is needed - no harness, no UI.
      //
      // No `args`: the form lives in the file, in `FROM_THE_UI`, so the pillar
      // and the format are changed where you are already reading. Breakpoints
      // worth setting, in order: `_run_agent` in harness/generator.py (the
      // input, complete, one line before it goes out), `_warn_if_the_method_was
      // _never_opened` (every tool call the run made, with its arguments), and
      // step 3 in this script (what came back, parsed).
      //
      // justMyCode STAYS TRUE HERE, and the reason is measured, not a habit.
      // Importing `agents.mcp` takes 4.5s under the debugger either way - the
      // flag alone costs nothing. But with the BREAKPOINTS panel's "Raised
      // Exceptions" ticked, the pair is ruinous: true takes 6s and false had
      // not finished the same import after ten minutes, because every one of
      // the ~130k exceptions Pydantic raises on import now happens in code the
      // debugger is willing to stop in. It looks exactly like a hang at
      // `import httpx`, and interrupting it lands you in `pydevd.get_file_type`.
      //
      // Set it to false when you actually need to step into `Runner.run`, and
      // untick every exception filter first. Then do not linger: the run has a
      // 20-minute timeout and the container 10.
      "name": "6. One real run (COSTS MONEY)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tests/checks/paid/run_like_production.py",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "pythonArgs": ["-X", "frozen_modules=off"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "PYTHONIOENCODING": "utf-8",
        "PYDEVD_DISABLE_FILE_VALIDATION": "1"
      },
      "justMyCode": true
    }
  ],
  "compounds": [
    {
      // THE ONE TO PICK to press "Generare" in the site with the debugger on.
      // Three processes, started in this order, all owned by the editor. The
      // debug toolbar gets a process picker, so you can stop inside the harness
      // and inside the MCP tool it calls.
      //
      // The UI is at http://127.0.0.1:5178 and opens by itself.
      "name": "Site complet (MCP + harness + UI)",
      "configurations": ["2. MCP server", "3. Harness (FastAPI)", "4. Blazor UI"],
      "stopAll": true
    }
  ]
}
