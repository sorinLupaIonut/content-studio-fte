{
  // D1b: the three services used during local development.
  // Secrets stay in `.env`; this committed file never contains keys.
  "version": "0.2.0",
  "configurations": [
    {
      // Internal business-data service. Start this before the harness.
      "name": "MCP server",
      "type": "debugpy",
      "request": "launch",
      "module": "content_studio.mcp_server.server",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      // Uvicorn serves the FastAPI object `app` from harness/main.py.
      // No --reload: it creates a child process that makes debugger ownership
      // and breakpoints less predictable.
      "name": "FastAPI harness",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "content_studio.harness.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "AUTH_MODE": "development",
        "HARNESS_HOST": "127.0.0.1"
      },
      "justMyCode": false
    },
    {
      // Standalone Blazor WebAssembly development host. It calls FastAPI on 8000.
      "name": "Blazor UI",
      "type": "coreclr",
      "request": "launch",
      "program": "${env:ProgramFiles}\\dotnet\\dotnet.exe",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/ui/StudioViorela/StudioViorela.csproj",
        "--no-launch-profile",
        "--urls",
        "http://127.0.0.1:5178"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Now listening on:\\s+(https?://\\S+)"
      }
    }
  ],
  "compounds": [
    {
      // Select this one to start the entire local product with one F5.
      // The harness may boot before MCP; /health reports degraded until MCP is ready.
      "name": "Studio complet (3 servicii)",
      "configurations": ["MCP server", "FastAPI harness", "Blazor UI"],
      "stopAll": true
    }
  ]
}
