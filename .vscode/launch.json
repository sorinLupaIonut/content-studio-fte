{
  // The services used during local development, plus the two ways to debug
  // something the editor did not start itself.
  // Secrets stay in `.env`; this committed file never contains keys.
  // Every configuration keeps `justMyCode: true`, and the launch configurations
  // are paired with attach ones. Both exist for the same measured reason:
  // importing `harness.main` raises 130_891 exceptions — all caught inside
  // Pydantic and FastAPI, all normal — and any pydevd setting that inspects them
  // walks the stack per exception (~84 frames each, ~11M in total). The import
  // goes from 5s to minutes, which reads as a frozen launch. Attaching after
  // startup skips all of it, because by then the imports are done.
  "version": "0.2.0",
  "configurations": [
    {
      // Internal business-data service. Start this before the harness.
      "name": "MCP server",
      "type": "debugpy",
      "request": "launch",
      "module": "content_studio.mcp_server.server",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      // Uvicorn serves the FastAPI object `app` from harness/main.py.
      // No --reload: it creates a child process that makes debugger ownership
      // and breakpoints less predictable.
      "name": "FastAPI harness",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "content_studio.harness.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "AUTH_MODE": "development",
        "HARNESS_HOST": "127.0.0.1"
      },
      "justMyCode": true
    },
    {
      // Standalone Blazor WebAssembly development host. It calls FastAPI on 8000.
      // Deliberately not `type: coreclr`. That type comes from the C# extension,
      // and even with the extension installed it would attach to the DevServer
      // process, which is a static file server; the application itself runs in the
      // browser's WebAssembly runtime, where a .NET debugger on this side cannot
      // see it. `node-terminal` ships inside VS Code, needs no extension, and does
      // the one thing this process needs: run the command in a terminal and stop
      // with the rest of the compound. Debug the C# that runs in the browser from
      // the browser's own devtools instead.
      "name": "Blazor UI",
      "type": "node-terminal",
      "request": "launch",
      "command": "dotnet run --project ui/StudioViorela/StudioViorela.csproj --no-launch-profile --urls http://127.0.0.1:5178",
      "cwd": "${workspaceFolder}",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Now listening on:\\s+(https?://\\S+)"
      }
    },
    {
      // The terminal front. Same worker, same gate, no browser — the cheapest
      // place to step through a turn, because you drive it by typing.
      // It reads with `input()`, so the integrated terminal is mandatory here.
      "name": "CLI worker",
      "type": "debugpy",
      "request": "launch",
      "module": "content_studio.worker",
      "args": ["--new"],
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      // The whole free suite under the debugger. Put a breakpoint in a failing
      // test and start here instead of reading the traceback.
      "name": "Unit tests",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["discover", "-s", "tests/unit"],
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    // Attaching comes in two flavours, and the difference is `pathMappings`.
    // A local process reports real Windows paths (E:\...\src\...), so a mapping
    // onto the image's /app/src describes a filesystem that is not there; the
    // editor then looks for the breakpoint's file under a path the process never
    // reports, and it binds to nothing. In a container the same mapping is
    // exactly what makes it work. One config each, rather than one that is
    // subtly wrong half the time.

    {
      // For a process this editor did not launch but that runs on this machine:
      // the terminals the tasks open, or one started by hand —
      //
      //   $env:DEBUGPY_PORT=5678; uv run uvicorn content_studio.harness.main:app `
      //     --host 127.0.0.1 --port 8000
      //
      // Add DEBUGPY_WAIT=1 when the bug is in startup itself, so the process
      // blocks until this configuration connects.
      "name": "Attach: harness (local)",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "127.0.0.1",
        "port": 5678
      },
      "justMyCode": true
    },
    {
      // The same door for the data service. Two ports, because both processes
      // can be under the debugger at once and one listener cannot serve both.
      "name": "Attach: MCP server (local)",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "127.0.0.1",
        "port": 5679
      },
      "justMyCode": true
    },
    {
      // Once the service runs in an image: docker run -e DEBUGPY_PORT=5678 -p 5678:5678
      // `remoteRoot` is where the sources live inside it, and it has to match the
      // WORKDIR the Dockerfile sets — that file does not exist yet (decision D2),
      // so treat /app/src as the value to keep in sync, not as a fact.
      "name": "Attach: harness (container)",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "127.0.0.1",
        "port": 5678
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}/src",
          "remoteRoot": "/app/src"
        }
      ],
      "justMyCode": true
    }
  ],
  "compounds": [
    {
      // The one to select. The pre-launch task starts all three services in
      // their own terminals — none of them under a debugger — and waits until
      // each reports its port open; only then do the two attach configurations
      // connect. That order is what makes debugging usable here: see the note at
      // the top of the file.
      //
      // The UI is at http://127.0.0.1:5178 and the harness at :8000.
      // Stopping the debug session detaches; the three terminals keep running,
      // so re-attaching costs nothing. Starting again is also safe: the task
      // sweeps this workspace's leftover processes before it starts new ones,
      // so a second F5 can no longer silently re-attach to the old ones.
      "name": "Studio complet (attach pe MCP + harness)",
      "configurations": ["Attach: harness (local)", "Attach: MCP server (local)"],
      "preLaunchTask": "Pornește toate serviciile",
      "stopAll": true
    },
    {
      // The old shape, kept because it is the one every VS Code tutorial shows:
      // the editor launches each service itself. On this project it is slow to
      // the point of looking frozen — the debugger inspects every exception
      // raised while Pydantic builds its models — so reach for the compound
      // above instead. This one stays useful only for a stripped-down process.
      "name": "Studio complet (launch direct — lent)",
      "configurations": ["MCP server", "FastAPI harness", "Blazor UI"],
      "stopAll": true
    },
    {
      // The shape the container will have: no .NET process at all. The UI is
      // published to disk first (the pre-launch task) and FastAPI serves it from
      // `/`, exactly as the image will. Open http://127.0.0.1:8000 — not 5178.
      // Slower to start and no hot reload, so use it to check the served build
      // rather than to write Razor.
      "name": "Studio ca in container (MCP + harness)",
      "configurations": ["MCP server", "FastAPI harness"],
      "preLaunchTask": "Publică UI-ul",
      "stopAll": true
    },
    {
      // The terminal path: the data service plus the worker that talks to it.
      // Two processes, so the debug toolbar gets a process picker and you can
      // stop inside the worker and inside the MCP tool it calls.
      "name": "Terminal (MCP + CLI)",
      "configurations": ["MCP server", "CLI worker"],
      "stopAll": true
    }
  ]
}
