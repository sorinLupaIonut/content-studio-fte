{
  // One task, used by the "Server + Worker" compound.
  //
  // Without it VS Code starts both processes at once, and the worker tries to read
  // the profile over MCP before the server has begun listening. The result is an
  // error that shows up one time in three — the kind that sends you looking through
  // the code for a problem that does not exist.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "wait-for-mcp",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-Command",
        // The port is 8765, the default MCP_PORT. If you change it in `.env`,
        // change it here too — otherwise you wait on a port nobody listens on.
        "$deadline = (Get-Date).AddSeconds(40); while ((Get-Date) -lt $deadline) { try { $c = New-Object Net.Sockets.TcpClient; $c.Connect('127.0.0.1', 8765); $c.Close(); Write-Host 'The MCP server is listening.'; exit 0 } catch { Start-Sleep -Milliseconds 400 } }; Write-Host 'The MCP server did not answer within 40 seconds.'; exit 1"
      ],
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "close": true
      },
      "problemMatcher": []
    }
  ]
}
