{
  // The project interpreter, so you do not pick it from the palette every time.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "python.terminal.activateEnvironment": true,

  // The Windows console is cp1252, and everything this project says to its user is
  // Romanian. The entry points fix their own output, but third-party libraries do
  // not — hence UTF-8 forced from the environment as well, for the integrated
  // terminal.
  "terminal.integrated.env.windows": {
    "PYTHONUTF8": "1",
    "PYTHONIOENCODING": "utf-8"
  },
  "files.encoding": "utf8",

  // Program output goes to the integrated terminal, not the Debug Console: the
  // worker reads with `input()`, so that is where the conversation happens.
  "debug.internalConsoleOptions": "neverOpen",

  // The large content files have no business in editor search.
  "search.exclude": {
    "**/.venv": true,
    "content/books/md": true,
    "evals/report-latest.json": true
  }
}
